---
import AuthGuard from '../components/AuthGuard.astro';
import { canonical } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "NoRMAhl - Deutsche Rockband" } = Astro.props;
const canonicalUrl = canonical(Astro.url.pathname);
const feedHref = `${import.meta.env.BASE_URL}konzerte/feed.xml`;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="generator" content="Astro">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}images/favicon.svg`}>
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" type="application/atom+xml" title="NoRMAhl – Konzerte" href={feedHref}>
</head>
<body>
  <AuthGuard />
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>