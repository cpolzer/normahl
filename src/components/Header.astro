---
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: base, label: 'Startseite' },
  { href: `${base}konzerte`, label: 'Konzerte' },
  ...(site.showNews ? [{ href: `${base}news`, label: 'News' }] : []),
  { href: `${base}presse`, label: 'Presse' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href={base} class="logo">
      <img src={`${import.meta.env.BASE_URL}images/adler-transparent.png`} alt="NoRMAhl" class="logo-img" />
    </a>
    
    <button class="mobile-toggle" aria-label="Menu" aria-controls="main-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
    
    <nav id="main-nav" class="main-nav">
      <ul class="nav-list">
        {navLinks.map(link => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
      <div class="nav-social">
        <a href="https://de-de.facebook.com/pages/category/Performing-Arts/NoRMAhl-253854581323142/" target="_blank" aria-label="Facebook">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M18.77,7.46H14.5v-1.9c0-.9.6-1.1,1-1.1h3V.5h-4.33C10.24.5,9.5,3.44,9.5,5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4Z"/></svg>
        </a>
        <a href="https://www.instagram.com/normahl_band" target="_blank" aria-label="Instagram">
