</footer>

<style>
  .site-footer {
    background: #0a0a0a;
    color: #fff;
    padding: 4rem 0 2rem;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    color: #fff;
  }

  .footer-col p {
    color: #888;
    margin: 0.5rem 0;
    font-size: 0.9rem;
  }

  .footer-col a {
    color: #888;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-social {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 0.75rem;
    margin-top: 0.25rem;
  }

  .footer-social a {
    color: #888;
    transition: color 0.2s ease;
  }

  .footer-social a:hover {
    color: #cc0000;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid #333;
  }

  .footer-link {
    color: #888;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: #fff;
  }

  .copyright {
    color: #666;
    font-size: 0.8rem;
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      text-align: center;
    }

.footer-bottom {
      justify-content: center;
      text-align: center;
    }

    .copyright {
      margin-left: 0;
      width: 100%;
    }
  }
</style>