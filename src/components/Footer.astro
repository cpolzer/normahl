    <div class="footer-bottom">
      <a href={`${base}impressum`} class="footer-link">Impressum</a>
      <a href={`${base}datenschutz`} class="footer-link">Datenschutz</a>
      <p class="copyright">&copy; {currentYear} NoRMAhl</p>
    </div>
