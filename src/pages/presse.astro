---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Presse - NoRMAhl">
  <Header />
  
  <main class="page-content">
    <div class="container">
      <h1 class="page-title">Presse</h1>
      
      <nav class="press-nav">
        <a href="#texte" class="press-nav-link">TEXTE</a>
        <a href="#bilder" class="press-nav-link">PRESSEBILDER</a>
        <a href="#promo" class="press-nav-link">PROMO</a>
        <a href="#druck" class="press-nav-link">DRUCKVORLAGEN</a>
      </nav>

      <!-- Texte -->
      <section id="texte" class="press-section">
        <h2 class="press-section-title">Texte</h2>
        
        <div class="press-subsection">
          <h3>Presseinfo</h3>
          <h4>Die Bandgeschichte</h4>
          <p>An ihren Songtext halten sich die Jungs von Normahl - einer der dienstältesten Punkbands im Land - nun schon seit über 40 Jahren: laut, schnell, angriffslustig, energiegeladen ...</p>
          <a href="/images/presse/Normahl-info2019.pdf" download class="btn btn-outline">Herunterladen</a>
        </div>
        
        <div class="press-subsection">
          <h4>Vinyl + Digital</h4>
          <p><strong>Live in Bayerland</strong></p>
          <p>Format: Doppel-LP in silbernem Vinyl<br>Label: Hulk Räckorz<br>Bestell-Nr: Hulk 330 - EAN: 0700811509043<br>Vertrieb: Edel Distribution<br>VÖ-Datum: 13.12.2019</p>
          <p class="photo-credit">Fotos: Susi Ecker, <a href="http://www.lautundwild.de/index.htm" target="_blank">lautundwild.de</a></p>
          
          <div class="press-links">
            <a href="https://punk.de/index.php?MainCat=1&SubCat=4&ProdID=12972" target="_blank" class="btn btn-primary">Kaufen @ Punk.de</a>
            <a href="/images/presse/Normahl_Bayerland_Cover_Druck.pdf" download class="btn btn-outline">Cover Download</a>
          </div>
        </div>
      </section>

      <!-- Pressebilder -->
      <section id="bilder" class="press-section">
        <h2 class="press-section-title">Pressebilder</h2>
        
        <div class="press-gallery">
          <div class="press-image">
            <img src="/images/hero/hero-1.jpg" alt="Band Foto 1" />
            <p>Band, Foto - TIF, 300dpi</p>
            <p class="photo-credit">Januar 2020, Lutz Schelhorn</p>
            <a href="/images/presse/fotoshooting_lutz_20.01.2020/p9V8A0278-2.tif" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <img src="/images/hero/hero-2.jpg" alt="Band Foto 2" />
            <p>Band, Foto - TIF, 300dpi</p>
            <p class="photo-credit">Januar 2020, Lutz Schelhorn</p>
            <a href="/images/presse/fotoshooting_lutz_20.01.2020/p9V8A0339.tif" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <img src="/images/hero/hero-3.jpg" alt="Band Foto 3" />
            <p>Band, Foto - TIF, 300dpi</p>
            <p class="photo-credit">Januar 2020, Lutz Schelhorn</p>
            <a href="/images/presse/fotoshooting_lutz_20.01.2020/p9V8A0452.tif" download class="btn btn-outline">Herunterladen</a>
          </div>
        </div>
      </section>

      <!-- Promo -->
      <section id="promo" class="press-section">
        <h2 class="press-section-title">Promo</h2>
        
        <div class="press-gallery">
          <div class="press-image">
            <img src="/images/presse/cover-big.jpg" alt="Cover Live in Bayerland" />
            <p>Cover Live in Bayerland</p>
            <p class="photo-credit">Fotos: Susi Ecker</p>
            <a href="/images/presse/cover-big.jpg" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <img src="/images/normahl-do-lp.jpg" alt="Bayerland vinyl preview" />
            <p>Bayerland vinyl preview</p>
            <p class="photo-credit">Fotos: Susi Ecker</p>
            <a href="/images/normahl-do-lp.jpg" download class="btn btn-outline">Herunterladen</a>
          </div>
        </div>
      </section>

      <!-- Druckvorlagen -->
      <section id="druck" class="press-section">
        <h2 class="press-section-title">Druckvorlagen</h2>
        
        <div class="press-gallery">
          <div class="press-image">
            <img src="/images/presse/logo_normahl_adler.jpg" alt="Logo Adler" />
            <h4>Logo Adler</h4>
            <p>23cm x 21,5cm 300dpi jpg-File</p>
            <a href="/images/presse/logo_normahl_adler.jpg" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <img src="/images/presse/grafiker/Normahl_Adler_1c_neg.jpg" alt="Logo Adler invertiert" />
            <h4>Logo Adler invertiert</h4>
            <p>jpg-File</p>
            <a href="/images/presse/grafiker/Normahl_Adler_1c_neg.jpg" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <img src="/images/presse/HB19_Normahl_Poster_A1+3mm.jpg" alt="Plakat Normahl 2020" />
            <h4>Plakat Normahl 2020</h4>
            <p>5906 x 8337px - 22mb</p>
            <a href="/images/presse/HB19_Normahl_Poster_A1+3mm.jpg" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <img src="/images/presse/grafiker/Normahl_Adler_Schriftzug.jpg" alt="Logo Adler mit Schrift" />
            <h4>Logo Adler mit Schrift</h4>
            <p>JPEG</p>
            <a href="/images/presse/grafiker/Normahl_Adler_Schriftzug.jpg" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <h4>Schriftzug Normahl</h4>
            <p>PDF-File</p>
            <a href="/images/presse/grafiker/Normahl_Schriftzug.pdf" download class="btn btn-outline">Herunterladen</a>
          </div>
          
          <div class="press-image">
            <img src="/images/logo-normahl-weiss.svg" alt="Normahl Logo Schrift" style="background:#000;padding:1rem;" />
            <h4>Normahl Logo Schrift</h4>
            <p>SVG</p>
            <a href="/images/logo-normahl-weiss.svg" download class="btn btn-outline">Herunterladen</a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-content {
    padding: 6rem 0 4rem;
    min-height: 60vh;
  }

  .page-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    text-align: center;
    text-transform: uppercase;
  }

  .press-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #0a0a0a;
  }

  .press-nav-link {
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.5rem 1rem;
    transition: all 0.2s ease;
  }

  .press-nav-link:hover {
    background: #0a0a0a;
    color: #fff;
  }

  .press-section {
    margin-bottom: 4rem;
    padding-top: 2rem;
  }

  .press-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #ddd;
  }

  .press-subsection {
    margin-bottom: 2rem;
  }

  .press-subsection h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .press-subsection h4 {
    font-size: 1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    color: #cc0000;
  }

  .press-subsection p {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  .photo-credit {
    font-size: 0.875rem;
    color: #666;
  }

  .press-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .press-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
  }

  .press-image {
    border: 2px solid #0a0a0a;
    padding: 1rem;
  }

  .press-image img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 1rem;
  }

  .press-image p {
    font-size: 0.875rem;
    margin: 0.5rem 0;
  }

  .press-image.no-preview {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

.press-image.no-preview img {
    display: none;
  }

  @media (max-width: 640px) {
    .press-nav {
      flex-direction: column;
      align-items: center;
    }
  }
</style>