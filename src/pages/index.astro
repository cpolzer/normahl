---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import concerts from '../data/concerts.json';
import news from '../data/news.json';
import site from '../data/site.json';

const upcomingConcerts = concerts
  .filter(c => !c.cancelled && !c.tbc && !/tbc/i.test(`${c.venue} ${c.city}`) && new Date(c.date) >= new Date())
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 6);

const sortedNews = news.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const base = import.meta.env.BASE_URL;
const heroImages = [
  `${base}images/hero/hero-1.jpg`,
  `${base}images/hero/hero-2.jpg`,
  `${base}images/hero/hero-3.jpg`,
];
---

<BaseLayout title="NoRMAhl - Punkrock `78">
  <Header />
  
  <main>
    <!-- Hero Section with rotating background -->
    <section class="hero">
      <div class="hero-slideshow">
        {heroImages.map((img, i) => (
          <div class="hero-slide" data-index={i} style={`background-image: url(${img})`}></div>
        ))}
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1 class="hero-title"><img src={`${base}images/hero/normahl-schrift.svg`} alt="NoRMAhl" class="hero-logo" /></h1>
        <p class="hero-subtitle">Punkrock `78</p>
        <div class="hero-actions">
          <a href="https://punk.de/?PreSearch=9" target="_blank" class="btn btn-primary">Kaufen</a>
          <a href="https://open.spotify.com/intl-de/artist/4A3ZGNdTWn4w4Aw6VFqoJm" target="_blank" class="btn btn-primary">Streamen</a>
          <a href="https://youtu.be/03dsocprW4Y" target="_blank" class="btn btn-primary">Video</a>
        </div>
      </div>
    </section>

    <!-- Konzerte Section -->
    <section id="konzerte" class="section section-adler">
      <div class="container">
        <h2 class="section-title">KONZERTE</h2>
        <div class="divider"></div>
        
        <div class="concerts-grid">
          {upcomingConcerts.map((concert) => (
            <a href={concert.ticketUrl} target="_blank" class="concert-card">
              <span class="concert-date">{new Date(concert.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}</span>
              <span class="concert-venue">{concert.venue}</span>
              <span class="concert-city">{concert.city}</span>
            </a>
          ))}
        </div>
        
        <div class="text-center mt-8">
          <a href={`${base}konzerte`} class="btn btn-outline">Alle Konzerte</a>
        </div>
      </div>
    </section>

    <!-- News Section -->
    {site.showNews && <section class="section section-gray">
      <div class="container">
        <h2 class="section-title">NEU</h2>
        <div class="divider"></div>
        
        <div class="news-tabs">
          <nav class="news-thumbnav">
            {sortedNews.map((item, index) => (
              <button 
                class:list={['news-thumb', { active: index === 0 }]} 
                data-index={index}
                aria-label={item.title}
              >
                <img src={`${base}${item.image.replace(/^\//, '')}`} alt={item.title} class="news-thumb-img" />
              </button>
            ))}
          </nav>
          
          <div class="news-content">
            {sortedNews.map((item, index) => (
              <div class:list={['news-panel', { active: index === 0 }]} data-index={index}>
                <div class="news-panel-inner">
                  <div class="news-image">
                    <img src={`${base}${item.image.replace(/^\//, '')}`} alt={item.title} />
                  </div>
                  <div class="news-text">
                    <h3 class="news-title">{item.title}</h3>
                    <p class="news-date">{new Date(item.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}</p>
                    <p class="news-body">{item.content || item.excerpt}</p>
                    {item.links?.map(link => (
                      <a href={link.url} target="_blank" class="btn btn-primary">{link.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>}
  </main>

  <Footer />

  {site.showPreview && <div id="config-bar">
    <span class="config-label">Preview</span>
    <button id="toggle-adler" class="config-btn">Adler: AN</button>
    <button id="toggle-hero-content" class="config-btn">Hero-Inhalt: AN</button>
    <span class="config-label">Farbe</span>
    <button class="config-btn color-btn" data-color="white">Weiß</button>
    <button class="config-btn color-btn" data-color="red">Rot</button>
    <button class="config-btn color-btn" data-color="grey">Grau</button>
    <button id="close-config" class="config-btn config-close" aria-label="Schließen">✕</button>
  </div>
  <button id="open-config" class="config-reopen" aria-label="Preview öffnen" hidden>⚙</button>}
</BaseLayout>

<script>
  // Config bar
  const adlerSection = document.querySelector('.section-adler') as HTMLElement | null;
  const heroContent = document.querySelector('.hero-content') as HTMLElement | null;
  const toggleAdler = document.getElementById('toggle-adler') as HTMLButtonElement;
  const toggleHero = document.getElementById('toggle-hero-content') as HTMLButtonElement;

  let adlerOn = localStorage.getItem('cfg_adler') === 'on';
  let heroOn = localStorage.getItem('cfg_hero') !== 'off';

  function applyAdler() {
    if (adlerSection) adlerSection.classList.toggle('adler-hidden', !adlerOn);
    toggleAdler.textContent = `Adler: ${adlerOn ? 'AN' : 'AUS'}`;
    toggleAdler.classList.toggle('off', !adlerOn);
  }

  function applyHero() {
    if (heroContent) heroContent.classList.toggle('hero-hidden', !heroOn);
    toggleHero.textContent = `Hero-Inhalt: ${heroOn ? 'AN' : 'AUS'}`;
    toggleHero.classList.toggle('off', !heroOn);
  }

  // Color theme
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const colorBtns = document.querySelectorAll<HTMLButtonElement>('.color-btn');
  let currentColor = localStorage.getItem('cfg_color') || 'white';

  function applyColor(color: string) {
    if (hero) hero.setAttribute('data-color', color);
    colorBtns.forEach(b => b.classList.toggle('active-color', b.dataset.color === color));
  }

  applyColor(currentColor);

  // Close/open config bar
  const configBar = document.getElementById('config-bar')!;
  const openBtn = document.getElementById('open-config')!;
  document.getElementById('close-config')!.addEventListener('click', () => {
    configBar.hidden = true;
    openBtn.hidden = false;
  });
  openBtn.addEventListener('click', () => {
    configBar.hidden = false;
    openBtn.hidden = true;
  });

  colorBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentColor = btn.dataset.color!;
      localStorage.setItem('cfg_color', currentColor);
      applyColor(currentColor);
    });
  });

  applyAdler();
  applyHero();

  toggleAdler.addEventListener('click', () => {
    adlerOn = !adlerOn;
    localStorage.setItem('cfg_adler', adlerOn ? 'on' : 'off');
    applyAdler();
  });

  toggleHero.addEventListener('click', () => {
    heroOn = !heroOn;
    localStorage.setItem('cfg_hero', heroOn ? 'on' : 'off');
    applyHero();
  });

  // Hero slideshow
  const heroSlides = document.querySelectorAll('.hero-slide');
  let currentSlide = 0;
  
  function showNextSlide() {
    heroSlides.forEach((slide, i) => {
      slide.classList.remove('active');
      if (i === currentSlide) {
        slide.classList.add('active');
      }
    });
    currentSlide = (currentSlide + 1) % heroSlides.length;
  }
  
  // Initialize first slide
  heroSlides[0]?.classList.add('active');
  
  // Rotate every 5 seconds
  setInterval(showNextSlide, 5000);
  
  // News tab switching
  const thumbs = document.querySelectorAll('.news-thumb');
  const panels = document.querySelectorAll('.news-panel');
  
  thumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => {
      thumbs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      thumb.classList.add('active');
      document.querySelector(`.news-panel[data-index="${i}"]`)?.classList.add('active');
    });
  });
</script>

<style>
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero-slideshow {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .hero-slide[data-index="1"] {
    background-size: 110%;
    background-position: 45% top;
  }

  .hero-slide.active {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10,10,10,0.85) 0%, rgba(26,26,26,0.7) 50%, rgba(10,10,10,0.85) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(3rem, 12vw, 8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.9;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    color: #fff;
  }

  .hero-logo {
    max-width: 80%;
    height: auto;
    max-height: 200px;
    display: block;
    margin: 0 auto;
  }

  .hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 300;
    color: #aaa;
    margin-bottom: 2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .section-adler {
    position: relative;
  }

  .section-adler::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/normahl/images/presse/logo_normahl_adler.jpg');
    background-repeat: no-repeat;
    background-position: center top;
    background-size: 100% auto;
    opacity: 0.04;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%), linear-gradient(to bottom, black 60%, transparent 100%);
    -webkit-mask-composite: destination-in;
    mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%), linear-gradient(to bottom, black 60%, transparent 100%);
    mask-composite: intersect;
    pointer-events: none;
  }

  .concerts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .concert-card {
    display: block;
    border: 2px solid #0a0a0a;
    padding: 1.5rem;
    transition: all 0.2s ease;
  }

  .concert-card:hover {
    background: #0a0a0a;
    color: #fff;
    transform: translateY(-4px);
    box-shadow: 6px 6px 0 #cc0000;
  }

  .concert-date {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .concert-venue {
    display: block;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .concert-city {
    display: block;
    color: #666;
    font-size: 0.875rem;
  }

  .section-gray {
    background: #f5f5f5;
  }

  .news-tabs {
    max-width: 900px;
    margin: 0 auto;
  }

  .news-thumbnav {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .news-thumb {
    width: 70px;
    height: 70px;
    border: 2px solid #ddd;
    background: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    overflow: hidden;
  }

  .news-thumb:hover {
    border-color: #0a0a0a;
  }

  .news-thumb.active {
    border-color: #0a0a0a;
    border-width: 3px;
  }

  .news-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-panel {
    display: none;
  }

  .news-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .news-panel-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .news-panel-inner {
      grid-template-columns: 300px 1fr;
    }
  }

  .news-image {
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid #0a0a0a;
  }

  .news-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .news-date {
    color: #666;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .news-body {
    margin-bottom: 1.5rem;
    white-space: pre-line;
    line-height: 1.7;
  }

  .adler-hidden::before { display: none; }
  .hero-hidden { opacity: 0; pointer-events: none; }

  /* white (default) */
  .hero[data-color="white"] .hero-logo { filter: invert(1); }

  /* red */
  .hero[data-color="red"] .hero-logo { filter: brightness(0) saturate(100%) invert(13%) sepia(99%) saturate(7471%) hue-rotate(3deg) brightness(95%) contrast(114%); }

  /* grey */
  .hero[data-color="grey"] .hero-logo { filter: invert(1) grayscale(1) brightness(0.75); }

  .config-btn.active-color { border-color: #fff; color: #fff; }
  .config-close { margin-left: 0.5rem; border-color: #555; }
  .config-reopen {
    position: fixed;
    top: 70px;
    right: 1rem;
    z-index: 99;
    background: rgba(10,10,10,0.85);
    color: #888;
    border: 1px solid #333;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .config-reopen:hover { color: #fff; }

  #config-bar {
    position: fixed;
    top: 70px;
    right: 1rem;
    z-index: 99;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(8px);
    padding: 0.4rem 0.75rem;
    border: 1px solid #333;
    font-size: 0.75rem;
  }

  .config-label {
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    margin-right: 0.25rem;
  }

  .config-btn {
    background: #1a1a1a;
    color: #ccc;
    border: 1px solid #444;
    padding: 0.25rem 0.6rem;
    font-size: 0.7rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.15s;
  }

  .config-btn:hover { border-color: #aaa; color: #fff; }
  .config-btn.off { color: #555; border-color: #333; }

  @media (max-width: 640px) {
    .hero-slide[data-index="1"] {
      background-size: cover;
      background-position: top center;
    }

    .hero {
      min-height: 85vh;
      align-items: flex-end;
    }

    .hero-content {
      padding: 1rem 1rem 2.5rem;
    }

    .hero-logo {
      max-height: 100px;
      max-width: 70%;
    }

    .hero-subtitle {
      font-size: 0.875rem;
      margin-bottom: 1.25rem;
      letter-spacing: 0.12em;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .hero-actions .btn {
      width: 100%;
      max-width: 220px;
    }
  }
</style>