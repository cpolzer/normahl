---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import concerts from '../data/concerts.json';
import news from '../data/news.json';
import site from '../data/site.json';

const upcomingConcerts = concerts
  .filter(c => !c.cancelled && !c.tbc && !/tbc/i.test(`${c.venue} ${c.city}`) && new Date(c.date) >= new Date())
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 6);

const sortedNews = news.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const base = import.meta.env.BASE_URL;
const heroImages = [
  `${base}images/hero/hero-1.jpg`,
  `${base}images/hero/hero-2.jpg`,
  `${base}images/hero/hero-3.jpg`,
];
const heroMobileImage = `${base}images/hero/hero-1-mobile.jpg`;
---

<BaseLayout title="NoRMAhl - Punkrock `78">
  <Header />
  
  <main>
    <!-- Hero Section with rotating background -->
    <section class="home-hero group relative flex min-h-[70vh] items-end justify-center overflow-hidden max-sm:min-h-[85vh]">
      <div class="absolute inset-0 max-sm:hidden">
        {heroImages.map((img, i) => (
          <div
            class="hero-slide absolute inset-0 bg-top bg-cover bg-no-repeat opacity-0 transition-opacity duration-1000 ease-in-out [&.active]:opacity-100 data-[index='1']:bg-[45%_top] data-[index='1']:bg-[length:110%]"
            data-index={i}
            style={`background-image: url(${img})`}
          ></div>
        ))}
      </div>
      <div
        class="absolute inset-0 hidden bg-cover bg-center bg-no-repeat max-sm:block"
        style={`background-image: url(${heroMobileImage})`}
      ></div>
      <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(10,10,10,0.85)_0%,rgba(26,26,26,0.7)_50%,rgba(10,10,10,0.85)_100%)]"></div>
      <div class="hero-content relative z-10 flex flex-col items-center px-8 pt-8 pb-16 text-center transition-opacity [&.hero-hidden]:pointer-events-none [&.hero-hidden]:opacity-0 max-sm:px-4 max-sm:pt-4 max-sm:pb-10">
        <h1 class="mb-2 text-[clamp(3rem,12vw,8rem)] leading-[0.9] font-black tracking-[-0.04em] text-white uppercase">
          <img
            src={`${base}images/hero/normahl-schrift.svg`}
            alt="NoRMAhl"
            class="mx-auto block h-auto max-h-[200px] max-w-[80%] group-data-[color='red']:[filter:brightness(0)_saturate(100%)_invert(13%)_sepia(99%)_saturate(7471%)_hue-rotate(3deg)_brightness(95%)_contrast(114%)] group-data-[color='white']:invert group-data-[color='grey']:grayscale group-data-[color='grey']:invert group-data-[color='grey']:brightness-75 max-sm:max-h-[100px] max-sm:max-w-[70%]"
          />
        </h1>
        <p class="mb-8 text-[clamp(1.25rem,3vw,1.75rem)] font-light tracking-[0.2em] text-[#aaa] uppercase max-sm:mb-5 max-sm:text-sm max-sm:tracking-[0.12em]">Punkrock `78</p>
        <div class="flex flex-wrap justify-center gap-4 max-sm:flex-col max-sm:items-center max-sm:gap-2">
          <a href="https://punk.de/?PreSearch=9" target="_blank" class="btn btn-primary max-sm:w-full max-sm:max-w-[220px]">Kaufen</a>
          <a href="https://open.spotify.com/intl-de/artist/4A3ZGNdTWn4w4Aw6VFqoJm" target="_blank" class="btn btn-primary max-sm:w-full max-sm:max-w-[220px]">Streamen</a>
          <a href="https://youtu.be/03dsocprW4Y" target="_blank" class="btn btn-primary max-sm:w-full max-sm:max-w-[220px]">Video</a>
        </div>
      </div>
    </section>

    <!-- Konzerte Section -->
    <section id="konzerte" class="section section-adler">
      <div class="container">
        <h2 class="section-title">KONZERTE</h2>
        <div class="divider"></div>

        <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6">
          {upcomingConcerts.map((concert) => (
            <a
              href={concert.ticketUrl}
              target="_blank"
              class="block border-2 border-black p-6 transition-all duration-200 hover:-translate-y-1 hover:bg-black hover:text-white hover:shadow-[6px_6px_0_var(--color-accent)]"
            >
              <span class="mb-2 block text-2xl font-bold">{new Date(concert.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}</span>
              <span class="block text-lg font-medium">{concert.venue}</span>
              <span class="block text-sm text-[#666]">{concert.city}</span>
            </a>
          ))}
        </div>

        <div class="text-center mt-8">
          <a href={`${base}konzerte`} class="btn btn-outline">Alle Konzerte</a>
        </div>
      </div>
    </section>

    <!-- News Section -->
    {site.showNews && <section class="section bg-[#f5f5f5]">
      <div class="container">
        <h2 class="section-title">NEU</h2>
        <div class="divider"></div>

        <div class="mx-auto max-w-[900px]">
          <nav class="mb-8 flex flex-wrap justify-center gap-3">
            {sortedNews.map((item, index) => (
              <button
                class:list={['news-thumb h-[70px] w-[70px] cursor-pointer overflow-hidden border-2 border-[#ddd] bg-white p-0 transition-all duration-200 hover:border-black [&.active]:border-[3px] [&.active]:border-black', { active: index === 0 }]}
                data-index={index}
                aria-label={item.title}
              >
                <img src={`${base}${item.image.replace(/^\//, '')}`} alt={item.title} class="h-full w-full object-cover" />
              </button>
            ))}
          </nav>

          <div>
            {sortedNews.map((item, index) => (
              <div class:list={['news-panel hidden [&.active]:block [&.active]:animate-[fadeIn_0.3s_ease]', { active: index === 0 }]} data-index={index}>
                <div class="grid grid-cols-1 items-start gap-8 sm:grid-cols-[300px_1fr]">
                  <div class="aspect-square overflow-hidden border-2 border-black">
                    <img src={`${base}${item.image.replace(/^\//, '')}`} alt={item.title} class="h-full w-full object-cover" />
                  </div>
                  <div>
                    <h3 class="mb-2 text-[1.75rem] leading-[1.2] font-bold">{item.title}</h3>
                    <p class="mb-4 text-sm text-[#666]">{new Date(item.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}</p>
                    <p class="mb-6 leading-[1.7] whitespace-pre-line">{item.content || item.excerpt}</p>
                    {item.links?.map(link => (
                      <a href={link.url} target="_blank" class="btn btn-primary">{link.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>}
  </main>

  <Footer />

  {site.showPreview && <div id="config-bar" class="fixed top-[70px] right-4 z-[99] flex items-center gap-2 border border-[#333] bg-black/85 px-3 py-1.5 text-xs backdrop-blur-[8px]">
    <span class="config-label mr-1 text-[0.7rem] tracking-[0.08em] text-[#666] uppercase">Preview</span>
    <button id="toggle-adler" class="config-btn">Adler: AN</button>
    <button id="toggle-hero-content" class="config-btn">Hero-Inhalt: AN</button>
    <span class="config-label mr-1 text-[0.7rem] tracking-[0.08em] text-[#666] uppercase">Farbe</span>
    <button class="config-btn color-btn" data-color="white">Weiß</button>
    <button class="config-btn color-btn" data-color="red">Rot</button>
    <button class="config-btn color-btn" data-color="grey">Grau</button>
    <button id="close-config" class="config-btn ml-2 border-[#555]" aria-label="Schließen">✕</button>
  </div>
  <button id="open-config" class="config-reopen fixed top-[70px] right-4 z-[99] flex h-8 w-8 cursor-pointer items-center justify-center border border-[#333] bg-black/85 text-base text-[#888] hover:text-white" aria-label="Preview öffnen" hidden>⚙</button>}
</BaseLayout>

<script>
  // Config bar
  const adlerSection = document.querySelector('.section-adler') as HTMLElement | null;
  const heroContent = document.querySelector('.hero-content') as HTMLElement | null;
  const toggleAdler = document.getElementById('toggle-adler') as HTMLButtonElement;
  const toggleHero = document.getElementById('toggle-hero-content') as HTMLButtonElement;

  let adlerOn = localStorage.getItem('cfg_adler') === 'on';
  let heroOn = localStorage.getItem('cfg_hero') !== 'off';

  function applyAdler() {
    if (adlerSection) adlerSection.classList.toggle('adler-hidden', !adlerOn);
    toggleAdler.textContent = `Adler: ${adlerOn ? 'AN' : 'AUS'}`;
    toggleAdler.classList.toggle('off', !adlerOn);
  }

  function applyHero() {
    if (heroContent) heroContent.classList.toggle('hero-hidden', !heroOn);
    toggleHero.textContent = `Hero-Inhalt: ${heroOn ? 'AN' : 'AUS'}`;
    toggleHero.classList.toggle('off', !heroOn);
  }

  // Color theme
  const hero = document.querySelector('.home-hero') as HTMLElement | null;
  const colorBtns = document.querySelectorAll<HTMLButtonElement>('.color-btn');
  let currentColor = localStorage.getItem('cfg_color') || 'white';

  function applyColor(color: string) {
    if (hero) hero.setAttribute('data-color', color);
    colorBtns.forEach(b => b.classList.toggle('active-color', b.dataset.color === color));
  }

  applyColor(currentColor);

  // Close/open config bar
  const configBar = document.getElementById('config-bar')!;
  const openBtn = document.getElementById('open-config')!;
  document.getElementById('close-config')!.addEventListener('click', () => {
    configBar.hidden = true;
    openBtn.hidden = false;
  });
  openBtn.addEventListener('click', () => {
    configBar.hidden = false;
    openBtn.hidden = true;
  });

  colorBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentColor = btn.dataset.color!;
      localStorage.setItem('cfg_color', currentColor);
      applyColor(currentColor);
    });
  });

  applyAdler();
  applyHero();

  toggleAdler.addEventListener('click', () => {
    adlerOn = !adlerOn;
    localStorage.setItem('cfg_adler', adlerOn ? 'on' : 'off');
    applyAdler();
  });

  toggleHero.addEventListener('click', () => {
    heroOn = !heroOn;
    localStorage.setItem('cfg_hero', heroOn ? 'on' : 'off');
    applyHero();
  });

  // Hero slideshow
  const heroSlides = document.querySelectorAll('.hero-slide');
  let currentSlide = 0;

  function showNextSlide() {
    heroSlides.forEach((slide, i) => {
      slide.classList.remove('active');
      if (i === currentSlide) slide.classList.add('active');
    });
    currentSlide = (currentSlide + 1) % heroSlides.length;
  }
  
  // Initialize first slide
  heroSlides[0]?.classList.add('active');
  
  // Rotate every 5 seconds
  setInterval(showNextSlide, 5000);
  
  // News tab switching
  const thumbs = document.querySelectorAll('.news-thumb');
  const panels = document.querySelectorAll('.news-panel');
  
  thumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => {
      thumbs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      thumb.classList.add('active');
      document.querySelector(`.news-panel[data-index="${i}"]`)?.classList.add('active');
    });
  });
</script>

<style>
  .section-adler {
    position: relative;
  }

  .section-adler::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/normahl/images/presse/logo_normahl_adler.jpg');
    background-repeat: no-repeat;
    background-position: center top;
    background-size: 100% auto;
    opacity: 0.04;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%), linear-gradient(to bottom, black 60%, transparent 100%);
    -webkit-mask-composite: destination-in;
    mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%), linear-gradient(to bottom, black 60%, transparent 100%);
    mask-composite: intersect;
    pointer-events: none;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .adler-hidden::before { display: none; }

  .config-btn {
    background: #1a1a1a;
    color: #ccc;
    border: 1px solid #444;
    padding: 0.25rem 0.6rem;
    font-size: 0.7rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.15s;
  }

  .config-btn:hover { border-color: #aaa; color: #fff; }
  .config-btn.off { color: #555; border-color: #333; }
  .config-btn.active-color { border-color: #fff; color: #fff; }
</style>