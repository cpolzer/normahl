---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import concerts from '../data/concerts.json';
import news from '../data/news.json';

const upcomingConcerts = concerts
  .filter(c => !c.cancelled && new Date(c.date) >= new Date())
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 6);

const sortedNews = news.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const heroImages = [
  '/images/hero/band-1.jpg',
  '/images/hero/band-2.jpg', 
  '/images/hero/band-3.jpg',
];
---

<BaseLayout title="NoRMAhl - Deutsche Rockband">
  <Header />
  
  <main>
    <!-- Hero Section with rotating background -->
    <section class="hero">
      <div class="hero-slideshow">
        {heroImages.map((img, i) => (
          <div class="hero-slide" data-index={i} style={`background-image: url(${img})`}></div>
        ))}
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1 class="hero-title">NoRMAhl</h1>
        <p class="hero-subtitle">Live in Bayerland</p>
        <div class="hero-actions">
          <a href="https://www.amazon.de/Live-Bayerland-Jahre-Diesel-Bier/dp/B07L19C25K" target="_blank" class="btn btn-primary">Kaufen</a>
          <a href="https://open.spotify.com/album/42CUl09G2oeiWsw7IPnlWU" target="_blank" class="btn btn-primary">Streamen</a>
          <a href="https://youtu.be/03dsocprW4Y" target="_blank" class="btn btn-outline">Video</a>
        </div>
      </div>
    </section>

    <!-- Konzerte Section -->
    <section id="konzerte" class="section">
      <div class="container">
        <h2 class="section-title">KONZERTE</h2>
        <div class="divider"></div>
        
        <div class="concerts-grid">
          {upcomingConcerts.map((concert) => (
            <a href={concert.ticketUrl} target="_blank" class="concert-card">
              <span class="concert-date">{new Date(concert.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}</span>
              <span class="concert-venue">{concert.venue}</span>
              <span class="concert-city">{concert.city}</span>
            </a>
          ))}
        </div>
        
        <div class="text-center mt-8">
          <a href="/konzerte" class="btn btn-outline">Alle Konzerte</a>
        </div>
      </div>
    </section>

    <!-- News Section -->
    <section class="section section-gray">
      <div class="container">
        <h2 class="section-title">NEU</h2>
        <div class="divider"></div>
        
        <div class="news-tabs">
          <nav class="news-thumbnav">
            {sortedNews.map((item, index) => (
              <button 
                class:list={['news-thumb', { active: index === 0 }]} 
                data-index={index}
                aria-label={item.title}
              >
                <img src={item.image} alt={item.title} class="news-thumb-img" />
              </button>
            ))}
          </nav>
          
          <div class="news-content">
            {sortedNews.map((item, index) => (
              <div class:list={['news-panel', { active: index === 0 }]} data-index={index}>
                <div class="news-panel-inner">
                  <div class="news-image">
                    <img src={item.image} alt={item.title} />
                  </div>
                  <div class="news-text">
                    <h3 class="news-title">{item.title}</h3>
                    <p class="news-date">{new Date(item.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}</p>
                    <p class="news-body">{item.content || item.excerpt}</p>
                    {item.links?.map(link => (
                      <a href={link.url} target="_blank" class="btn btn-primary">{link.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Hero slideshow
  const heroSlides = document.querySelectorAll('.hero-slide');
  let currentSlide = 0;
  
  function showNextSlide() {
    heroSlides.forEach((slide, i) => {
      slide.classList.remove('active');
      if (i === currentSlide) {
        slide.classList.add('active');
      }
    });
    currentSlide = (currentSlide + 1) % heroSlides.length;
  }
  
  // Initialize first slide
  heroSlides[0]?.classList.add('active');
  
  // Rotate every 5 seconds
  setInterval(showNextSlide, 5000);
  
  // News tab switching
  const thumbs = document.querySelectorAll('.news-thumb');
  const panels = document.querySelectorAll('.news-panel');
  
  thumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => {
      thumbs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      thumb.classList.add('active');
      document.querySelector(`.news-panel[data-index="${i}"]`)?.classList.add('active');
    });
  });
</script>

<style>
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero-slideshow {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .hero-slide.active {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10,10,10,0.85) 0%, rgba(26,26,26,0.7) 50%, rgba(10,10,10,0.85) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem;
  }

  .hero-title {
    font-size: clamp(3rem, 12vw, 8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.9;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    color: #fff;
  }

  .hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 300;
    color: #aaa;
    margin-bottom: 2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .concerts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .concert-card {
    display: block;
    border: 2px solid #0a0a0a;
    padding: 1.5rem;
    transition: all 0.2s ease;
  }

  .concert-card:hover {
    background: #0a0a0a;
    color: #fff;
    transform: translateY(-4px);
    box-shadow: 6px 6px 0 #cc0000;
  }

  .concert-date {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .concert-venue {
    display: block;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .concert-city {
    display: block;
    color: #666;
    font-size: 0.875rem;
  }

  .section-gray {
    background: #f5f5f5;
  }

  .news-tabs {
    max-width: 900px;
    margin: 0 auto;
  }

  .news-thumbnav {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .news-thumb {
    width: 70px;
    height: 70px;
    border: 2px solid #ddd;
    background: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    overflow: hidden;
  }

  .news-thumb:hover {
    border-color: #0a0a0a;
  }

  .news-thumb.active {
    border-color: #0a0a0a;
    border-width: 3px;
  }

  .news-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-panel {
    display: none;
  }

  .news-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .news-panel-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .news-panel-inner {
      grid-template-columns: 300px 1fr;
    }
  }

  .news-image {
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid #0a0a0a;
  }

  .news-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .news-date {
    color: #666;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .news-body {
    margin-bottom: 1.5rem;
    white-space: pre-line;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 60vh;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
    }

    .hero-actions .btn {
      width: 100%;
      max-width: 200px;
    }
  }
</style>